+  height:min(790px,calc(100dvh - 36px));max-height:calc(100dvh - 36px);
+  border:1px solid rgba(230,189,116,.4);border-radius:24px;
+  background:var(--lm-bg);color:var(--lm-text);box-shadow:0 38px 140px rgba(0,4,12,.88),0 0 0 1px rgba(255,255,255,.03);
+  color-scheme:dark;isolation:isolate;
+}
