+/* ORBITA Launch Mission Control · visual redesign 2026-11-21
+ * Deliberately scoped: the map and the upcoming-landing dialog retain their own UI.
+ * No external image/font/API dependency; decorative orbital shapes are SVG/CSS.
+ */
+.launch-mission-dock {
+  --lm-gold:#e9bb70; --lm-cyan:#62dbea;
+  position:absolute;left:18px;bottom:39px;z-index:28;
+  display:flex;align-items:center;gap:11px;width:248px;min-height:76px;
+  padding:11px 12px;direction:rtl;text-align:start;cursor:pointer;
+  border:1px solid rgba(237,195,119,.61);border-radius:17px;
+  background:linear-gradient(115deg,rgba(13,42,59,.97),rgba(5,19,34,.99));
+  color:#f9f6eb;box-shadow:0 14px 40px rgba(0,0,0,.48),0 0 0 1px rgba(5,18,28,.6),inset 0 1px 0 rgba(252,232,181,.12);
+  isolation:isolate;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s;
+}
+.launch-mission-dock::before{content:"";position:absolute;inset:0;background:linear-gradient(98deg,transparent 15%,rgba(95,215,231,.07) 55%,transparent 91%);pointer-events:none;z-index:-1}
+.launch-mission-dock::after{content:"";position:absolute;bottom:0;inset-inline:38px 38px;height:2px;background:linear-gradient(90deg,transparent,#e9bb70,transparent);opacity:.8}
+.launch-mission-dock:hover,.launch-mission-dock[aria-expanded="true"]{transform:translateY(-3px);border-color:#ffe0a0;box-shadow:0 19px 46px rgba(0,0,0,.55),0 0 24px rgba(215,171,94,.16)}
+.launch-mission-dock:focus-visible{outline:3px solid #67e7ee;outline-offset:4px}
+.launch-mission-dock-signal{display:grid;place-items:center;flex:0 0 52px;width:52px;height:52px;position:relative;color:var(--lm-cyan);border:1px solid rgba(111,225,229,.22);border-radius:14px;background:radial-gradient(circle at 50% 55%,rgba(61,153,177,.23),rgba(9,32,48,.1) 70%)}
+.launch-mission-dock-signal svg{display:block;width:46px;height:46px;transition:transform .2s}
+.launch-mission-dock:hover .launch-mission-dock-signal svg{transform:translateY(-2px) rotate(-4deg)}
+.launch-mission-dock-ping{position:absolute;top:3px;left:4px;width:7px;height:7px;border-radius:100%;background:#68e3cb;box-shadow:0 0 0 3px rgba(104,227,203,.11),0 0 12px #68e3cb}
+.launch-mission-dock-copy{display:flex;flex-direction:column;flex:1;min-width:0;gap:3px}
+.launch-mission-dock-eyebrow{color:var(--lm-gold);font-size:10px;font-weight:600;letter-spacing:.015em}
+.launch-mission-dock-title{font-size:14px;font-weight:800;line-height:1.5;white-space:nowrap;color:#fff6e8}
+.launch-mission-dock-arrow{flex:0 0 16px;width:16px;height:16px;color:var(--lm-gold);transform:rotate(180deg);transition:transform .2s}
+.launch-mission-dock-arrow svg{width:100%;height:100%}
+.launch-mission-dock:hover .launch-mission-dock-arrow{transform:rotate(180deg) translateX(-3px)}
+#view-map:has(#detail.open) .launch-mission-dock,
+#view-map:has(#layerPanel:not([hidden])) .launch-mission-dock{opacity:0;pointer-events:none;transform:translateY(12px)}
+
+/* Full mission-room surface. No selector below changes the landing browser. */
+.launch-mission-dialog{
+  --lm-bg:#061522;--lm-panel:#0b2031;--lm-panel-2:#0d283a;--lm-line:rgba(121,185,208,.18);
