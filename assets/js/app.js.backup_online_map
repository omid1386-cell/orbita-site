  function allPoints() {
    var p = [];
    DATA.companies.forEach(function (c) { p.push({ kind: "company", cat: c.cat, o: c }); });
    DATA.sites.forEach(function (s) { p.push({ kind: "site", cat: "site", o: s }); });
    return p;
