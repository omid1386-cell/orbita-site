 /* RASPEHR stage-5: typographic identifiers are not corporate logos. */
 .verified-profile-v2 .verified-brand-identifier{display:grid;place-items:center;text-align:center;max-width:100%;width:100%;height:100%;font:800 clamp(11px,1.3vw,15px)/1.1 system-ui,Arial,sans-serif;letter-spacing:.015em;color:var(--v-hi);overflow-wrap:anywhere;user-select:none}
+
+
+/* =====================================================================
+   ORBITA Step 3 — accessible logo enlargement lightbox
+   Only verified entity logos opt in via data-logo-zoom="true".
+   ===================================================================== */
+img[data-logo-zoom="true"]{
+  cursor:zoom-in;
+  -webkit-tap-highlight-color:transparent;
+  transition:filter .16s ease,outline-color .16s ease,transform .16s ease;
+}
+img[data-logo-zoom="true"]:hover{filter:brightness(1.08)}
+img[data-logo-zoom="true"]:focus-visible{
+  outline:2px solid var(--accent-tx,var(--accent));
+  outline-offset:3px;
+}
+.logo-zoom-dialog{
+  width:min(94vw,1100px);
+  max-width:94vw;
+  max-height:92vh;
+  margin:auto;
+  padding:0;
+  border:1px solid color-mix(in srgb,var(--accent) 36%,var(--line));
+  border-radius:18px;
+  overflow:hidden;
+  color:var(--text);
+  background:var(--panel-solid,var(--panel));
+  box-shadow:0 28px 100px rgba(0,0,0,.58);
+}
+.logo-zoom-dialog::backdrop{
+  background:rgba(2,8,18,.86);
+  -webkit-backdrop-filter:blur(8px);
+  backdrop-filter:blur(8px);
+}
+.logo-zoom-shell{
+  display:flex;
+  flex-direction:column;
+  gap:11px;
+  max-height:92vh;
+  padding:14px;
+}
+.logo-zoom-toolbar{
+  display:flex;
+  align-items:center;
+  justify-content:space-between;
+  gap:12px;
+  min-width:0;
+}
+.logo-zoom-heading{display:flex;flex-direction:column;gap:3px;min-width:0}
+.logo-zoom-eyebrow{font-size:10px;color:var(--accent-tx,var(--accent));font-weight:700}
+.logo-zoom-title{font-size:13px;line-height:1.55;overflow-wrap:anywhere}
+.logo-zoom-close{
+  flex:0 0 34px;
+  width:34px;height:34px;
+  display:grid;place-items:center;
+  border:1px solid var(--line);
+  border-radius:10px;
+  color:var(--text);
+  background:var(--bg2);
+  font:700 23px/1 Arial,sans-serif;
+  cursor:pointer;
+}
+.logo-zoom-close:hover{border-color:var(--accent);color:var(--accent-tx,var(--accent))}
+.logo-zoom-close:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.logo-zoom-stage{
+  display:grid;
+  place-items:center;
+  width:100%;
+  min-height:150px;
+  max-height:calc(92vh - 92px);
+  overflow:auto;
+  padding:18px;
+  border:1px solid var(--line);
+  border-radius:13px;
+  background:var(--bg2);
+  overscroll-behavior:contain;
+}
+.logo-zoom-stage img{
+  display:block;
+  width:auto;
+  height:auto;
+  max-width:100%;
+  max-height:calc(84vh - 88px);
+  object-fit:contain;
+  object-position:center;
+  user-select:none;
+  -webkit-user-drag:none;
+  touch-action:pan-x pan-y pinch-zoom;
+}
+.logo-zoom-hint{
+  margin:0;
+  color:var(--muted);
+  font-size:10px;
+  line-height:1.7;
+  text-align:center;
