+/* ORBITA — Step 7: readable event metadata, status and empty states.
+   Shared presentation refinements only; launch mission control retains its unique skin. */
+.global-launch-dialog .event-display-update-row{display:flex;align-items:center;gap:7px 10px;flex-wrap:wrap;margin-top:6px;max-width:100%}
+.global-launch-dialog .event-display-updated{display:inline-block;line-height:1.7;overflow-wrap:anywhere}
+.global-launch-dialog .event-display-freshness{display:inline-flex;align-items:center;gap:6px;padding:3px 8px;border:1px solid var(--line);border-radius:999px;background:var(--bg2);font-size:10px;font-weight:700;line-height:1.5;color:var(--muted);white-space:normal;text-align:start}
+.global-launch-dialog .event-display-freshness::before{content:"";width:6px;height:6px;flex:0 0 6px;border-radius:50%;background:currentColor;opacity:.85}
+.global-launch-dialog .event-display-freshness.is-fresh{color:var(--green);border-color:color-mix(in srgb,var(--green) 35%,var(--line))}
+.global-launch-dialog .event-display-freshness.is-stale,.global-launch-dialog .event-display-freshness.is-invalid{color:var(--amber);border-color:color-mix(in srgb,var(--amber) 35%,var(--line))}
+.global-launch-dialog .event-display-freshness.is-missing{color:var(--muted)}
+.global-launch-dialog .event-display-info-strip{flex:0 0 auto;display:grid;gap:5px;padding:9px 13px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg2) 42%,transparent)}
+.global-launch-dialog .event-display-coverage-note,.global-launch-dialog .event-display-clock-note{margin:0;line-height:1.7;color:var(--muted);font-size:10px;overflow-wrap:anywhere}
+.global-launch-dialog .event-display-clock-note{border-inline-start:2px solid var(--accent);padding-inline-start:9px;color:var(--text)}
+.global-launch-dialog .event-display-date{min-width:0;max-width:46%;gap:4px;overflow-wrap:anywhere}
+.global-launch-dialog .event-display-date-caption{color:var(--muted);font-size:9px;font-weight:600;line-height:1.4}
+.global-launch-dialog .event-display-date bdi{font-variant-numeric:tabular-nums;direction:auto;unicode-bidi:isolate;line-height:1.7}
+.global-launch-dialog .event-display-date-basis{display:block;white-space:normal;overflow-wrap:anywhere;line-height:1.6}
+.global-launch-dialog .global-launch-card-title{min-width:0;flex-wrap:wrap}
+.global-launch-dialog .global-launch-card-title strong{overflow-wrap:anywhere}
+.global-launch-dialog .global-launch-status{white-space:normal;line-height:1.5;text-align:center}
+.global-launch-dialog .global-launch-results-head-actions{display:flex;gap:10px;align-items:center;justify-content:space-between}
+.global-launch-dialog .global-launch-feed-state{max-width:min(100%,670px);margin:0;line-height:1.75;overflow-wrap:anywhere}
+.global-launch-dialog .global-launch-empty{flex-direction:column;gap:9px}
+.global-launch-dialog .global-launch-empty>p{margin:0;max-width:520px;line-height:1.8}
+.global-launch-dialog .event-display-empty-tip{opacity:.8;font-size:10px}
+.global-launch-dialog .event-display-empty-symbol{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;font-size:25px;border:1px dashed var(--line);color:var(--accent-tx)}
+.global-launch-dialog .event-display-reset{min-height:38px;padding:8px 15px;border:1px solid var(--accent);border-radius:9px;background:color-mix(in srgb,var(--accent) 15%,var(--bg2));color:var(--accent-tx);font-family:inherit;font-size:11px;font-weight:700;cursor:pointer}
+.global-launch-dialog .event-display-reset:hover{background:color-mix(in srgb,var(--accent) 26%,var(--bg2))}
+.global-launch-dialog .event-display-reset:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
+.global-launch-dialog .global-launch-result-count{font-variant-numeric:tabular-nums}
+/* Distinctive launch mission room: only metadata refinements, not a redesign. */
+.launch-mission-dialog .event-display-info-strip{background:linear-gradient(90deg,rgba(15,50,67,.75),rgba(9,32,48,.75));border-bottom-color:rgba(97,166,190,.24);padding:11px 18px}
+.launch-mission-dialog .event-display-coverage-note{color:#a7c3cf;font-size:10px}
+.launch-mission-dialog .event-display-clock-note{border-inline-start-color:#d7a962;color:#e9d4ad;font-size:10px}
+.launch-mission-dialog .event-display-freshness{background:rgba(12,42,55,.84);border-color:rgba(86,168,188,.35);color:#b9e2e6;font-size:10px}
+.launch-mission-dialog .event-display-freshness.is-fresh{color:#8be7c6;border-color:rgba(107,222,181,.38)}
+.launch-mission-dialog .event-display-freshness.is-stale,.launch-mission-dialog .event-display-freshness.is-invalid{color:#f7c981;border-color:rgba(246,193,108,.45)}
+.launch-mission-dialog .event-display-date-caption{color:#adc9d4}
